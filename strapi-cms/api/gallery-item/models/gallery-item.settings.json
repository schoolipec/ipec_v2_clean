{
  "kind": "collectionType",
  "collectionName": "gallery_items",
  "info": {
    "name": "gallery-item"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    }
  }
}
