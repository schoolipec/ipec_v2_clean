{
  "kind": "collectionType",
  "collectionName": "abouts",
  "info": {
    "name": "about"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "mission": {
      "type": "text"
    },
    "vision": {
      "type": "text"
    },
    "values": {
      "type": "json"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "order": {
      "type": "integer",
      "default": 2
    }
  }
}
