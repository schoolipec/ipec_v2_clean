{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "name": "service"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "icon": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "color": {
      "type": "string",
      "default": "#328045"
    },
    "order": {
      "type": "integer"
    }
  }
}
