{
  "kind": "singleType",
  "collectionName": "global_settings",
  "info": {
    "name": "global-setting"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "site_name": {
      "type": "string",
      "required": true
    },
    "site_description": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "primary_color": {
      "type": "string"
    },
    "secondary_color": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "fonts": {
      "type": "json"
    }
  }
}
