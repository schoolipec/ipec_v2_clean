{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "name": "testimonial"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "author_name": {
      "type": "string",
      "required": true
    },
    "author_role": {
      "type": "string"
    },
    "content": {
      "type": "text",
      "required": true
    },
    "author_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "rating": {
      "type": "integer"
    },
    "order": {
      "type": "integer"
    }
  }
}
