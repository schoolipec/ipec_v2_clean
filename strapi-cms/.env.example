################################################################################
# IPEC v2 Clean - Strapi v5 Environment Configuration
#
# IMPORTANTE:
# 1. Copiar este archivo a .env (NO versionar .env en git)
# 2. En desarrollo: cambiar secrets por valores simples
# 3. En producción: generar secrets aleatorios fuertes (openssl rand -base64 32)
# 4. Crear archivo .env.local para secretos locales (NO versionar)
################################################################################

################################################################################
# 1. DATABASE CONFIGURATION
################################################################################

# Tipo de base de datos
DATABASE_CLIENT=postgres

# Host (dentro de Docker: "postgres", desde fuera: "localhost")
DATABASE_HOST=postgres

# Puerto (interno: 5432, externo: 5433)
DATABASE_PORT=5432

# Nombre de la base de datos
DATABASE_NAME=strapi_ipec

# Usuario de PostgreSQL
DATABASE_USERNAME=strapi_user

# Contraseña de PostgreSQL (CAMBIAR EN PRODUCCIÓN)
POSTGRES_PASSWORD=change_me_in_production

# SSL para conexión a DB (false en desarrollo, true en producción)
DATABASE_SSL=false

################################################################################
# 2. SECURITY SECRETS (GENERAR CON: openssl rand -base64 32)
################################################################################

# JWT Secret - Para autenticación de admin
# DEV: puedes usar cualquier string > 16 caracteres
# PROD: generar con openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production

# API Token Salt - Para generar API tokens
API_TOKEN_SALT=your_api_token_salt_min_32_chars_change_in_production

# Admin JWT Secret - Para sesiones de admin
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_chars_change_in_production

# App Keys - Lista de claves para encriptación (separadas por coma)
APP_KEYS=key1_min_32_chars,key2_min_32_chars,key3_min_32_chars

# Transfer Token Salt - Para migraciones y transferencias
TRANSFER_TOKEN_SALT=your_transfer_token_salt_min_32_chars_change_in_production

################################################################################
# 3. ENVIRONMENT & NODE
################################################################################

# development | staging | production
NODE_ENV=development

# Puerto API
API_PORT=1337

# URL externa de Strapi (para admin y APIs externas)
# DEV: http://localhost:1337
# PROD: https://api.suplenitud.com
API_URL=http://localhost:1337

# URL interna para admin panel
STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

################################################################################
# 4. STRAPI PATHS
################################################################################

# Prefijo para todas las rutas de API
STRAPI_URL_PREFIX=/api

# Ruta del panel admin
ADMIN_PATH=/admin

################################################################################
# 5. CORS & SECURITY
################################################################################

# Mostrar solo admin (sin APIs públicas)
STRAPI_ADMIN_ONLY=false

# Orígenes permitidos (CORS)
# DEV: *
# PROD: especificar dominios exactos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:1337

# Headers adicionales para CORS
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS,HEAD

################################################################################
# 6. TIMEZONE
################################################################################

TZ=America/Los_Angeles

################################################################################
# 7. NODE OPTIONS (para memoria)
################################################################################

# Aumentar memoria disponible para Node.js (si es necesario)
NODE_OPTIONS=--max-old-space-size=2048

################################################################################
# 8. CLOUDFLARE TUNNEL (opcional - si usas tunnel)
################################################################################

# CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
# CLOUDFLARE_ZONE_ID=your_zone_id_here
# CLOUDFLARE_DOMAIN=api.suplenitud.com

################################################################################
# NOTAS PARA DESARROLLO
################################################################################

# 1. Para desarrollo local:
#    - DATABASE_HOST=postgres
#    - NODE_ENV=development
#    - Cualquier secret > 16 chars es OK
#
# 2. Para VPS Hostinger:
#    - DATABASE_HOST=localhost (o IP de servidor)
#    - NODE_ENV=production
#    - Generar todos los secrets con openssl
#
# 3. Para Cloudflare Tunnel:
#    - No necesitas exponer puertos
#    - Configurar URL externa en STRAPI_ADMIN_BACKEND_URL
#
# 4. Multiidioma:
#    - Activar en Settings > Internationalization > Locales
#    - Idiomas: es, en, pt, ko, de
